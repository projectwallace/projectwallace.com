{
	"name": "project-wallace-com",
	"version": "0.0.1",
	"private": true,
	"description": "Svelte Kit project for projectwallace.com",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "svelte-kit sync && playwright test",
		"test:unit": "vitest --exclude **/*.spec.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint:ts": "oxlint --config oxlintrc.json",
		"lint": "pnpm check; pnpm lint:ts; pnpm format:check; pnpm stylelint",
		"stylelint": "stylelint \"src/**/*.{css,svelte}\" --ignore-path .gitignore --report-needless-disables --report-descriptionless-disables --report-unscoped-disables",
		"stylelint-full": "vite build >/dev/null 2>&1 && find .svelte-kit/output/server/_app/immutable/assets -name '*.css' -exec cat {} + > .svelte-kit/holistic.css 2>/dev/null && format-css .svelte-kit/holistic.css > .svelte-kit/holistic-formatted.css 2>/dev/null && stylelint .svelte-kit/holistic-formatted.css --config=.stylelintrc.mjs",
		"css-coverage": "css-coverage ./css-coverage --min-coverage=.95  --min-file-coverage=.85 --show-uncovered=all"
	},
	"dependencies": {
		"@melt-ui/pp": "^0.3.2",
		"@melt-ui/svelte": "^0.86.6",
		"@oddbird/popover-polyfill": "^0.6.1",
		"@projectwallace/css-analyzer": "catalog:",
		"@projectwallace/css-code-coverage": "^1.0.4",
		"@projectwallace/css-code-quality": "^3.1.4",
		"@projectwallace/css-design-tokens": "^0.11.11",
		"@projectwallace/css-layer-tree": "^2.1.5",
		"@projectwallace/css-parser": "catalog:",
		"@projectwallace/css-time-sort": "^3.1.1",
		"@projectwallace/format-css": "catalog:",
		"@projectwallace/stylelint-plugin": "catalog:",
		"color-sorter": "catalog:",
		"diff": "^9.0.0",
		"github-slugger": "^2.0.0",
		"lightningcss": "1.32.0",
		"linkedom": "^0.18.13",
		"mdsvex": "^0.12.8",
		"paneforge": "^1.0.2",
		"prism-svelte": "^0.5.0",
		"prismjs": "^1.30.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"runed": "^0.37.1",
		"svelte": "^5.56.8",
		"typescript": "^6.0.3",
		"vite": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@projectwallace/preset-oxlint": "^0.0.11",
		"@projectwallace/stylelint-plugin": "catalog:",
		"@sveltejs/adapter-netlify": "next",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^25.9.5",
		"oxfmt": "0.55.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^0.23.0",
		"postcss-html": "^1.8.1",
		"stylelint": "~17.14.1",
		"stylelint-config-standard": "~40.0.0",
		"svelte-check": "^4.7.5",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.17.0"
}
